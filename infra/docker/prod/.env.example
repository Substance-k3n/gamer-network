# Copy to .env (gitignored) and fill in. Keep a copy somewhere safe:
# the database password is in it. docs/DEPLOY.md explains each one.

# DNS for all three must point at the server.
WEB_DOMAIN=example.com
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=gn
POSTGRES_DB=gn
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Email codes (Resend). The MAIL_FROM domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=rally <no-reply@example.com>
# Push: the Firebase service account JSON, base64 (base64 -w0 key.json).
FIREBASE_SERVICE_ACCOUNT=
# Google sign-in: OAuth client ids (Android, web), comma separated. Optional.
GOOGLE_CLIENT_IDS=

# Cloudflare R2 (S3 API). Endpoint: https://<account id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Avatars: public reads (r2.dev or a custom domain) on MEDIA_PUBLIC_URL.
S3_BUCKET=gn-media
MEDIA_PUBLIC_URL=https://media.example.com
# Database backups: a second, private bucket, with its own token
# limited to that bucket.
BACKUP_S3_BUCKET=gn-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# The app (the API answers 426 below MIN_APP_VERSION).
MIN_APP_VERSION=0.0.0
LATEST_APP_VERSION=1.0.0
LAUNCH_CITY=Addis Ababa

# Share pages (apps/web). See apps/web/.env.example.
ANDROID_PACKAGE=com.example.rally
ANDROID_CERT_SHA256=
PLAY_STORE_URL=
CONTACT_EMAIL=
