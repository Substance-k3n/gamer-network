            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "summary": "Create an account with email + password. Sends a verification code.",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/login": {
