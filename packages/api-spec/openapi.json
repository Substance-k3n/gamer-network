  "info": {
    "title": "gamer-network API",
    "description": "Conventions: docs/API.md. Every non-2xx response is an ErrorResponse.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AgeRange": {
        "type": "string",
        "enum": [
          "16_17",
          "18_24",
          "25_34",
          "35_plus"
        ]
      },
      "SignupBody": {
        "type": "object",
        "properties": {
          "ageRange": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgeRange"
              }
            ]
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "username": {
            "type": "string",
            "description": "Stored lowercase."
          },
          "password": {
            "type": "string",
            "description": "8–72 characters.",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "ageRange",
          "email",
          "displayName",
          "username",
          "password"
        ]
      },
      "PlayerStatus": {
        "type": "string",
        "enum": [
          "looking",
          "playing",
          "available_tonight",
          "not_available"
        ],
        "description": "Already reset to not_available once its time has passed."
      },
      "Day": {
        "type": "string",
        "enum": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "Platform": {
        "type": "string",
        "enum": [
          "pc",
          "playstation",
          "xbox",
          "mobile",
          "switch"
        ]
      },
      "PlayTag": {
        "type": "string",
        "enum": [
          "competitive",
          "casual",
          "fps",
          "rpg",
          "strategy",
          "co_op",
          "ranked",
          "achievement_hunter",
          "story"
        ]
      },
      "Relationship": {
        "type": "string",
        "enum": [
          "self",
          "none",
          "outgoing_request",
          "incoming_request",
          "connected"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "player",
          "admin"
        ]
      },
      "GameRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shortCode": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "shortCode"
        ]
      },
      "RankRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tier": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "tier"
        ]
      },
      "RoleRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UserGameDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "game": {
            "nullable": true,
            "description": "Null for a custom game.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/GameRefDto"
              }
            ]
          },
          "customGameName": {
            "type": "string",
            "nullable": true,
            "description": "Set only for a custom game."
          },
          "rank": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/RankRefDto"
              }
            ]
          },
          "rankText": {
            "type": "string",
            "nullable": true,
            "description": "Free-text level, custom games only."
          },
          "role": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/RoleRefDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "game",
          "customGameName",
          "rank",
          "rankText",
          "role"
        ]
      },
      "GamingIdKind": {
        "type": "string",
        "enum": [
          "riot",
          "steam",
          "discord",
          "playstation",
          "xbox",
          "epic",
          "ea",
          "activision",
          "in_game"
        ]
      },
      "IdVisibility": {
        "type": "string",
        "enum": [
          "public",
          "connections"
        ]
      },
      "GamingIdDto": {
        "type": "object",
        "properties": {
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GamingIdKind"
              }
            ]
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdVisibility"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "game": {
            "nullable": true,
            "description": "Set when kind is in_game.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/GameRefDto"
              }
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "visibility",
          "id",
          "game",
          "value"
        ]
      },
      "ProfileStatsDto": {
        "type": "object",
        "properties": {
          "connections": {
            "type": "number"
          },
          "games": {
            "type": "number"
          },
          "playedWith": {
            "type": "number",
            "description": "Different people you checked in \"played\" with."
          }
        },
        "required": [
          "connections",
          "games",
          "playedWith"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Already reset to not_available once its time has passed.",
            "allOf": [
              {
                "$ref": "#/components/schemas/PlayerStatus"
              }
            ]
          },
          "ageRange": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AgeRange"
              }
            ]
          },
          "availableDays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Day"
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Platform"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayTag"
            }
          },
          "relationship": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Relationship"
              }
            ]
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "hasPassword": {
            "type": "boolean",
            "description": "False for Google-only accounts, so Settings can offer \"Set a password\"."
          },
          "country": {
            "type": "string"
          },
          "onboardedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "Null until \"Go live\"; route to onboarding while null."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "statusUntil": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
