{
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "import", "react", "nextjs"],
  "ignorePatterns": ["**/dist/**", "**/.next/**", "apps/mobile/**", "**/next-env.d.ts"],
  "rules": {
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "env": {
    "node": true
  }
}
