PORT=3300
# infra/docker/dev/compose.yml
DATABASE_URL=postgres://gn:password@localhost:5470/gn
# Apps below this version get 426 and must update.
MIN_APP_VERSION=0.0.0
LATEST_APP_VERSION=1.0.0
LAUNCH_CITY=Addis Ababa
# Browser origins allowed to call the API: the PWA build and the web site.
WEB_ORIGINS=http://localhost:3000,http://localhost:8080
# Email. Without a key, codes are printed to the API console (dev only).
RESEND_API_KEY=
MAIL_FROM=gamer-network <no-reply@example.com>
# Google sign-in: OAuth client ids for Android, iOS and web, comma separated.
GOOGLE_CLIENT_IDS=
