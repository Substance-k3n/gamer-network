# Where the server calls the API (no /v1).
API_URL=http://localhost:3300
# This site's own address, for Open Graph links. Same as the API's PUBLIC_WEB_URL.
PUBLIC_WEB_URL=http://localhost:3000

# Android App Links (/.well-known/assetlinks.json). The release key's
# SHA-256 fingerprints, comma-separated, from Play Console → App integrity.
ANDROID_PACKAGE=com.example.rally
ANDROID_CERT_SHA256=
# The Play Store page; leave empty until the app is listed.
PLAY_STORE_URL=
# Shown on /privacy as the contact address. Empty shows a placeholder line.
CONTACT_EMAIL=
