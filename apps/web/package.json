{
  "name": "@app/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "api-types": "openapi-typescript ../../packages/api-spec/openapi.json -o src/lib/api.gen.ts",
    "dev": "pnpm api-types && next dev --port 3000",
    "build": "pnpm api-types && next build",
    "start": "next start --port 3000",
    "typecheck": "pnpm api-types && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@app/api-spec": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
