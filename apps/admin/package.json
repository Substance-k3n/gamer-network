{
  "name": "@app/admin",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "api-types": "openapi-typescript ../../packages/api-spec/openapi.json -o src/admin/api.gen.ts",
    "dev": "pnpm api-types && next dev --port 3001",
    "build": "pnpm api-types && next build",
    "start": "next start --port 3001",
    "typecheck": "pnpm api-types && tsc --noEmit",
    "deploy:cf": "opennextjs-cloudflare build && node ../../infra/cloudflare/drop-local-env.mjs && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@app/api-spec": "workspace:*",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
